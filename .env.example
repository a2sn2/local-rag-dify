# ==============================================================================
# Local RAG System — Environment Configuration Template (.env.example)
# Pinned Target: Dify 1.18.0 + Ollama Native + Weaviate Vector DB
#
# SECURITY WARNING:
# 1. Copy this file to '.env' before running Docker Compose.
# 2. Never commit '.env' to version control (protected by .gitignore).
# 3. Replace all placeholder values with cryptographically random secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Application Security Secrets
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 42
SECRET_KEY=replace_with_strong_random_secret_key_minimum_42_chars

# ------------------------------------------------------------------------------
# 2. Sandbox Execution Security Tokens (Dify 1.18.0)
# ------------------------------------------------------------------------------
# Code execution sandbox security token
# Generate with: openssl rand -base64 32
SANDBOX_API_KEY=replace_with_strong_random_sandbox_api_key
CODE_EXECUTION_API_KEY=replace_with_strong_random_sandbox_api_key

# Agent Local Sandbox Authentication Token (Required for Dify >= 1.16.0)
DIFY_AGENT_RUNTIME_BACKEND=local
DIFY_AGENT_LOCAL_SANDBOX_ENDPOINT=http://local_sandbox:5004
DIFY_AGENT_LOCAL_SANDBOX_AUTH_TOKEN=replace_with_strong_random_agent_sandbox_token

# ------------------------------------------------------------------------------
# 3. Network & Gateway Binding Configuration
# ------------------------------------------------------------------------------
# Web UI Gateway Port (Bound strictly to localhost loopback for single-machine security)
EXPOSE_NGINX_PORT=80
NGINX_PORT_BINDING=127.0.0.1
EXPOSE_NGINX_SSL_PORT=443

# ------------------------------------------------------------------------------
# 4. Host Model Engine (Ollama Integration)
# ------------------------------------------------------------------------------
# Ollama service reachable from inside Docker via host gateway
OLLAMA_API_BASE_URL=http://host.docker.internal:11434

# ------------------------------------------------------------------------------
# 5. Database & Cache Credentials (Internal Docker Bridge Only)
# ------------------------------------------------------------------------------
DB_USERNAME=postgres
DB_PASSWORD=replace_with_strong_db_password
DB_DATABASE=dify
DB_PORT=5432

REDIS_PORT=6379
REDIS_PASSWORD=replace_with_strong_redis_password

# ------------------------------------------------------------------------------
# 6. Vector Database Configuration (Weaviate Default)
# ------------------------------------------------------------------------------
VECTOR_STORE=weaviate
WEAVIATE_ENDPOINT=http://weaviate:8080
WEAVIATE_API_KEY=

# ------------------------------------------------------------------------------
# 7. File Storage Configuration
# ------------------------------------------------------------------------------
STORAGE_TYPE=opendal
STORAGE_LOCAL_PATH=storage
