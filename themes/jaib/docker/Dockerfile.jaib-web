# ==============================================================================
# Dockerfile: JAIB Visual Identity Custom Container for Dify Web v1.18.0
# Base: langgenius/dify-web:1.18.0
# Purpose: Clean standalone theme loading with highest cascade precedence,
# pure vector SVG co-branding, and ReactFlow LTR safeguards.
# NO brute-force chunk duplication.
# ==============================================================================
FROM langgenius/dify-web:1.18.0

USER root

# Copy theme styles, patch utility, and branding assets
COPY themes/jaib/css/jaib-theme.css /tmp/jaib-theme.css
COPY themes/jaib/docker/patch-server.js /tmp/patch-server.js
COPY themes/jaib/assets/ /tmp/jaib-assets/

# 1. Deploy standalone theme file to public directory (served with max-age=0)
# and append once to the single global Next.js root layout stylesheet (030bhy3_ddw-t.css)
# for 100% cascade precedence and React hydration resilience without 20-chunk duplication.
RUN mkdir -p /app/targets/next/web/public/themes/jaib && \
    cp /tmp/jaib-theme.css /app/targets/next/web/public/themes/jaib/jaib-theme.css && \
    cat /tmp/jaib-theme.css >> /app/targets/next/web/.next/static/chunks/030bhy3_ddw-t.css

# 2. Patch server.js for clean standalone head-injection (highest cascade precedence)
RUN node /tmp/patch-server.js

# 3. Deploy pure vector co-branded logo and brand assets to public web directories
RUN cp /tmp/jaib-assets/logo.svg /app/targets/next/web/public/logo/logo.svg && \
    cp /tmp/jaib-assets/logo-dark.svg /app/targets/next/web/public/logo/logo-dark.svg && \
    cp /tmp/jaib-assets/logo-site.png /app/targets/next/web/public/logo/logo-site.png && \
    cp /tmp/jaib-assets/logo-site-dark.png /app/targets/next/web/public/logo/logo-site-dark.png && \
    cp /tmp/jaib-assets/favicon.ico /app/targets/next/web/public/favicon.ico && \
    cp /tmp/jaib-assets/jaib-symbol-red.png /app/targets/next/web/public/logo/logo-embedded-chat-avatar.png && \
    cp /tmp/jaib-assets/jaib-horizontal-red.png /app/targets/next/web/public/logo/logo-embedded-chat-header.png && \
    cp /tmp/jaib-assets/jaib-horizontal-red.png /app/targets/next/web/public/logo/logo-embedded-chat-header@2x.png && \
    cp /tmp/jaib-assets/jaib-horizontal-red.png /app/targets/next/web/public/logo/logo-embedded-chat-header@3x.png && \
    mkdir -p /app/targets/next/web/public/jaib && \
    cp -r /tmp/jaib-assets/* /app/targets/next/web/public/jaib/

# 4. Restore non-root ownership and clean up temporary staging
RUN chown -R dify:dify /app/targets/next/web && \
    rm -rf /tmp/jaib-theme.css /tmp/patch-server.js /tmp/jaib-assets

USER dify
